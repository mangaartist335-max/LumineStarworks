# Connected Desktop environment template. Copy to .env.local if you need it.
# Nothing here is secret: the desktop needs no keys or tokens.

# Where YourAnimeList (the yal/ app) is served. The desktop's browser shows
# yal.connectedera.local from this address. Leave blank for local
# development (http://localhost:3100). On Vercel, use the YAL project's
# address, for example https://your-yal-project.vercel.app
NEXT_PUBLIC_YAL_ORIGIN=
