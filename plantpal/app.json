{
  "expo": {
    "name": "PlantPal",
    "slug": "plantpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantpal.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.plantpal.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantPal uses your photos so you can add a picture of each plant.",
          "cameraPermission": "PlantPal uses the camera so you can snap a photo of each plant."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ]
    ],
    "scheme": "plantpal"
  }
}
