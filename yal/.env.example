# YourAnimeList (YAL) environment template.
# Copy to .env.local. With the Supabase values left blank the site runs in
# local demonstration mode and stores member data in .data/yal.local.json.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: where local demonstration mode keeps its data file.
# YAL_DATA_DIR=.data

# Sites allowed to show YAL inside a frame (the Connected Desktop's browser),
# comma-separated. Leave blank for local development (http://localhost:3000).
# On Vercel, use the desktop project's address, for example
# https://your-desktop-project.vercel.app
NEXT_PUBLIC_YAL_EMBED_ORIGINS=
