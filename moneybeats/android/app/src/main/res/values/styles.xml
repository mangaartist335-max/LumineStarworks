<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MoneyBeats is always dark, so both themes use a dark base and the
         app background colour (no white flash while starting up). -->

    <!-- Shown while the Flutter engine starts; removed on the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI while the app runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
