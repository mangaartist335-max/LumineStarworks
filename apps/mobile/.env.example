# BuildBrief mobile app configuration. Copy to .env and fill in.
# These are PUBLIC values (they ship inside the app). Never put the Anthropic
# key or the Supabase service-role key here: those live only on the server.

# Same Supabase project as the website (Supabase: Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# The deployed BuildBrief website (it hosts the AI generation API).
EXPO_PUBLIC_API_BASE_URL=https://buildbrief-beta.vercel.app
