# ── Supabase (optional) ────────────────────────────────────────────────────
# Leave these empty to run on the local development store (seed data plus a
# JSON file in .data/). Fill them in to read from and write to Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only used by `npm run db:seed` to load the seed data into Supabase.
# Server-side only — never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "local" to use the local store even when Supabase is configured.
ARCHIVE_DATA_MODE=

# ── Local development mode ────────────────────────────────────────────────
# Passcode for the archive editor when running without Supabase.
# `npm run dev` falls back to "starworks"; production builds require a value.
LOCAL_EDITOR_PASSCODE=
# Extra secret mixed into the local editor session cookie.
LOCAL_SESSION_SECRET=
# Where local edits are saved (defaults to .data/archive.local.json).
ARCHIVE_LOCAL_FILE=

# ── Handy for demos ───────────────────────────────────────────────────────
# Pin "today" (YYYY-MM-DD) for status badges, upcoming premieres and anniversaries.
ARCHIVE_TODAY=
