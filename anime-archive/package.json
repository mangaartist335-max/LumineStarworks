{
  "name": "lumine-anime-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Lumine StarWorks Anime Industry Archive (2006\u20132026)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:seed-sql": "tsx scripts/generate-seed-sql.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-supabase.ts",
    "archive:export": "tsx scripts/export-archive.ts",
    "archive:reset-local": "tsx scripts/reset-local-store.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
